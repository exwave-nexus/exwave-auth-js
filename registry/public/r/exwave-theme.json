{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "exwave-theme",
  "title": "Exwave theme",
  "description": "Exwave's colors for light and dark, Nunito Sans, and success and warning colors, for any shadcn/ui app.",
  "dependencies": [
    "@fontsource-variable/nunito-sans"
  ],
  "cssVars": {
    "theme": {
      "font-sans": "\"Nunito Sans Variable\", ui-sans-serif, system-ui, sans-serif",
      "color-success": "var(--success)",
      "color-success-muted": "var(--success-muted)",
      "color-warning": "var(--warning)",
      "color-warning-muted": "var(--warning-muted)"
    },
    "light": {
      "background": "#ffffff",
      "foreground": "#121719",
      "card": "#ffffff",
      "card-foreground": "#121719",
      "popover": "#ffffff",
      "popover-foreground": "#121719",
      "primary": "#006fa7",
      "primary-foreground": "#ffffff",
      "secondary": "#eef3f5",
      "secondary-foreground": "#121719",
      "muted": "#eef3f5",
      "muted-foreground": "#5d707a",
      "accent": "#eaf5fb",
      "accent-foreground": "#005d8e",
      "destructive": "#b42318",
      "border": "#e3e8eb",
      "input": "#84949d",
      "ring": "#006fa7",
      "success": "#157f3c",
      "success-muted": "#ecfdf3",
      "warning": "#7a5713",
      "warning-muted": "#fbf4e4",
      "chart-1": "#006fa7",
      "chart-2": "#21b6f3",
      "chart-3": "#d6b064",
      "chart-4": "#157f3c",
      "chart-5": "#5d707a",
      "radius": "0.625rem",
      "sidebar": "#f6f8f9",
      "sidebar-foreground": "#121719",
      "sidebar-primary": "#006fa7",
      "sidebar-primary-foreground": "#ffffff",
      "sidebar-accent": "#eaf5fb",
      "sidebar-accent-foreground": "#005d8e",
      "sidebar-border": "#e3e8eb",
      "sidebar-ring": "#006fa7"
    },
    "dark": {
      "background": "#0c151a",
      "foreground": "#f5f7f7",
      "card": "#111b21",
      "card-foreground": "#f5f7f7",
      "popover": "#111b21",
      "popover-foreground": "#f5f7f7",
      "primary": "#006a98",
      "primary-foreground": "#ffffff",
      "secondary": "#17242b",
      "secondary-foreground": "#f5f7f7",
      "muted": "#17242b",
      "muted-foreground": "#a1aeb3",
      "accent": "#102530",
      "accent-foreground": "#21b6f3",
      "destructive": "#ff8f87",
      "border": "#ffffff1a",
      "input": "#56676f",
      "ring": "#21b6f3",
      "success": "#5fd38d",
      "success-muted": "#0f2418",
      "warning": "#d6b064",
      "warning-muted": "#231e12",
      "chart-1": "#21b6f3",
      "chart-2": "#83c9ec",
      "chart-3": "#d6b064",
      "chart-4": "#5fd38d",
      "chart-5": "#a1aeb3",
      "sidebar": "#101415",
      "sidebar-foreground": "#f5f7f7",
      "sidebar-primary": "#21b6f3",
      "sidebar-primary-foreground": "#0c151a",
      "sidebar-accent": "#102530",
      "sidebar-accent-foreground": "#21b6f3",
      "sidebar-border": "#ffffff1a",
      "sidebar-ring": "#21b6f3"
    }
  },
  "docs": "Import \"@fontsource-variable/nunito-sans\" once, in app/layout.tsx (or your entry file), so the font loads.",
  "type": "registry:theme"
}