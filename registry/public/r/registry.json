        },
        {
          "path": "registry/exwave/password-rules.tsx",
          "type": "registry:component",
          "target": "@components/exwave/password-rules.tsx"
        },
        {
          "path": "registry/exwave/verify-email.tsx",
          "type": "registry:component",
          "target": "@components/exwave/verify-email.tsx"
        },
        {
          "path": "registry/exwave/forgot-password-form.tsx",
          "type": "registry:component",
          "target": "@components/exwave/forgot-password-form.tsx"
        },
        {
          "path": "registry/exwave/reset-password-form.tsx",
          "type": "registry:component",
          "target": "@components/exwave/reset-password-form.tsx"
        },
        {
          "path": "registry/exwave/sign-out-button.tsx",
          "type": "registry:component",
          "target": "@components/exwave/sign-out-button.tsx"
        },
        {
          "path": "registry/exwave/user-button.tsx",
          "type": "registry:component",
          "target": "@components/exwave/user-button.tsx"
        }
      ],
      "envVars": {
        "VITE_EXWAVE_PUBLISHABLE_KEY": "exw_pk_from_nexus"
      },
      "docs": "Set VITE_EXWAVE_PUBLISHABLE_KEY (Nexus → Auth) in .env.local, then wrap your app in <ExwaveProvider publishableKey={import.meta.env.VITE_EXWAVE_PUBLISHABLE_KEY} navigate={yourRouterNavigate}> from @exwave-nexus/auth/react, and give each form a route. Guide: https://www.exwave.net/docs/auth/get-started/"
    }
  ]
}
