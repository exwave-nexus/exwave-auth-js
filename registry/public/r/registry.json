    {
      "name": "auth-nextjs",
      "type": "registry:block",
      "title": "Exwave Auth for Next.js",
      "description": "Sign-in, sign-up, email verification and password reset pages for the App Router, with the /api/exwave routes, the session proxy and every component.",
      "dependencies": [
        "@exwave-nexus/auth@^0.1.1",
        "lucide-react"
      ],
      "registryDependencies": [
        "button",
        "input",
        "label",
        "card",
        "avatar",
        "dropdown-menu"
      ],
      "files": [
        {
          "path": "registry/exwave/sign-in-form.tsx",
          "type": "registry:component",
          "target": "@components/exwave/sign-in-form.tsx"
        },
        {
          "path": "registry/exwave/auth-link.tsx",
          "type": "registry:component",
          "target": "@components/exwave/auth-link.tsx"
        },
        {
          "path": "registry/exwave/sign-up-form.tsx",
          "type": "registry:component",
          "target": "@components/exwave/sign-up-form.tsx"
        },
        {
          "path": "registry/exwave/password-rules.tsx",
          "type": "registry:component",
          "target": "@components/exwave/password-rules.tsx"
        },
        {
          "path": "registry/exwave/verify-email.tsx",
          "type": "registry:component",
          "target": "@components/exwave/verify-email.tsx"
        },
        {
          "path": "registry/exwave/forgot-password-form.tsx",
          "type": "registry:component",
          "target": "@components/exwave/forgot-password-form.tsx"
        },
        {
          "path": "registry/exwave/reset-password-form.tsx",
          "type": "registry:component",
          "target": "@components/exwave/reset-password-form.tsx"
        },
        {
          "path": "registry/exwave/sign-out-button.tsx",
          "type": "registry:component",
          "target": "@components/exwave/sign-out-button.tsx"
        },
        {
          "path": "registry/exwave/user-button.tsx",
          "type": "registry:component",
          "target": "@components/exwave/user-button.tsx"
        },
        {
          "path": "packages/create/templates/next/app/(auth)/sign-in/page.tsx",
          "type": "registry:page",
          "target": "app/(auth)/sign-in/page.tsx"
        },
        {
          "path": "packages/create/templates/next/app/(auth)/sign-up/page.tsx",
          "type": "registry:page",
          "target": "app/(auth)/sign-up/page.tsx"
        },
        {
          "path": "packages/create/templates/next/app/(auth)/verify/page.tsx",
          "type": "registry:page",
          "target": "app/(auth)/verify/page.tsx"
        },
        {
          "path": "packages/create/templates/next/app/(auth)/forgot-password/page.tsx",
          "type": "registry:page",
          "target": "app/(auth)/forgot-password/page.tsx"
        },
        {
          "path": "packages/create/templates/next/app/(auth)/reset-password/page.tsx",
          "type": "registry:page",
          "target": "app/(auth)/reset-password/page.tsx"
        },
        {
          "path": "packages/create/templates/next/app/(auth)/layout.tsx",
          "type": "registry:page",
          "target": "app/(auth)/layout.tsx"
        },
        {
          "path": "packages/create/templates/next/app/api/exwave/[...action]/route.ts",
          "type": "registry:file",
          "target": "app/api/exwave/[...action]/route.ts"
        },
        {
          "path": "packages/create/templates/next/lib/exwave.ts",
          "type": "registry:lib",
          "target": "@lib/exwave.ts"
        },
        {
          "path": "packages/create/templates/next/proxy.ts",
          "type": "registry:file",
          "target": "~/proxy.ts"
        }
      ],
      "envVars": {
        "NEXT_PUBLIC_EXWAVE_PUBLISHABLE_KEY": "exw_pk_from_nexus",
        "EXWAVE_COOKIE_SECRET": ""
      },
      "docs": "Set NEXT_PUBLIC_EXWAVE_PUBLISHABLE_KEY (Nexus → Auth) and EXWAVE_COOKIE_SECRET (openssl rand -base64 32) in .env.local, then wrap app/layout.tsx's body in <ExwaveProvider initialState={await exwave.getAuthState()}> from @exwave-nexus/auth/next/client. Guide: https://www.exwave.net/docs/auth/get-started/"
    },
    {
      "name": "auth-react",
      "type": "registry:block",
      "title": "Exwave Auth for React (Vite)",
      "description": "Every sign-in, sign-up, email verification and password reset component, for a React app that talks to Exwave Auth from the browser.",
