{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "exwave",
  "homepage": "https://www.exwave.net/docs/auth/",
  "items": [
    {
      "name": "sign-in-form",
      "type": "registry:component",
      "title": "Sign in form",
      "description": "Email or username and password, with the reason the last session ended and a new verification link when needed.",
      "dependencies": [
        "@exwave-nexus/auth@^0.1.1"
      ],
      "registryDependencies": [
        "button",
        "input",
        "label",
        "card"
      ],
      "files": [
        {
          "path": "registry/exwave/sign-in-form.tsx",
          "type": "registry:component",
          "target": "@components/exwave/sign-in-form.tsx"
        },
        {
          "path": "registry/exwave/auth-link.tsx",
          "type": "registry:component",
          "target": "@components/exwave/auth-link.tsx"
        }
      ]
    },
    {
      "name": "sign-up-form",
      "type": "registry:component",
      "title": "Sign up form",
      "description": "Name, email and password with the platform's rules ticked off as you type, then a check-your-email step with resend.",
      "dependencies": [
        "@exwave-nexus/auth@^0.1.1",
        "lucide-react"
      ],
      "registryDependencies": [
        "button",
