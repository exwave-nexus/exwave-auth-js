{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@/components/exwave/*": ["./exwave/*", "./next-app/components/exwave/*"],
      "@/components/ui/*": ["./ui/*"],
      "@/components/theme-provider": [
        "./next-app/components/theme-provider.tsx"
      ],
      "@/lib/utils": ["./lib/utils.ts"],
      "@/lib/exwave": ["./next/lib/exwave.ts"],
      "@/lib/local-mock": ["./next-app/lib/local-mock.ts"]
    }
  },
  "include": ["exwave", "ui", "lib", "next", "next-app"]
}
