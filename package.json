{
  "name": "exwave-auth-js",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "mock": "bun scripts/mock-auth.ts",
    "dev:spa": "bun run --cwd examples/vite-spa dev",
    "dev:next": "bun run --cwd examples/next-server dev",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json && bun run --filter '*' typecheck",
    "test": "bun test",
    "build": "bun run --filter '*' build",
    "size": "bun scripts/bundle-size.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.4",
    "jose": "6.2.17",
    "typescript": "6.0.3"
  }
}
