{
  "name": "exwave-auth-js",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "packages/*",
    "packages/create/templates/*"
  ],
  "scripts": {
    "mock": "bun packages/auth-mock/src/cli.ts",
    "dev:next": "bun run --cwd packages/create/templates/next dev",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json && bun run --filter '*' typecheck",
    "test": "bun test",
    "build": "bun run --filter '*' build",
    "size": "bun scripts/bundle-size.ts",
    "stage": "bun run build && bun scripts/stage.ts packages/auth && bun scripts/stage.ts packages/auth-mock && bun scripts/stage.ts packages/create",
    "check-versions": "bun scripts/check-versions.ts",
    "dev:vite": "bun run --cwd packages/create/templates/vite dev",
    "registry:build": "bun scripts/registry.ts build",
    "registry:sync": "bun scripts/registry.ts sync",
    "registry:check": "bun scripts/registry.ts check",
    "smoke": "bun scripts/smoke.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.4",
    "jose": "6.2.17",
    "shadcn": "4.23.0",
    "typescript": "6.0.3"
  }
}
