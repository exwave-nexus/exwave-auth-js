{
  "name": "@exwave-nexus/auth-mock",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "An in-memory Exwave Auth API for local development and tests. Not for production.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exwave-nexus/exwave-auth-js.git",
    "directory": "packages/auth-mock"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "exwave-auth-mock": "./src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "bun build.ts",
    "stage": "bun build.ts && bun ../../scripts/stage.ts ."
  },
  "dependencies": {
    "@exwave-nexus/auth": "workspace:*",
    "jose": "6.2.17"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "6.0.3"
  }
}
