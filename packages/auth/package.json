{
  "name": "@exwave-nexus/auth",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Exwave Auth for websites and apps: the browser and route clients, messages and the server side, for any framework or none.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exwave-nexus/exwave-auth-js.git",
    "directory": "packages/auth"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./messages": "./src/messages.ts",
    "./server": "./src/server/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "bun build.ts",
    "stage": "bun build.ts && bun ../../scripts/stage.ts ."
  },
  "dependencies": {
    "jose": "6.2.17"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "6.0.3"
  }
}
